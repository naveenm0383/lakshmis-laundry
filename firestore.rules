rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function email() { return signedIn() ? request.auth.token.email.lower() : ""; }
    function owner() { return email() == "naveenm0383@gmail.com"; }
    function accessExists() { return signedIn() && exists(/databases/$(database)/documents/staffAccess/$(email())); }
    function access() { return get(/databases/$(database)/documents/staffAccess/$(email())).data; }
    function activeStaff() { return owner() || (accessExists() && access().active == true); }
    function role(r) { return owner() || (activeStaff() && access().role == r); }
    function admin() { return owner() || role("Admin"); }
    function manager() { return admin() || role("Store manager"); }
    function counter() { return role("Store staff"); }
    function processor() { return role("Processing"); }
    function rider() { return role("Rider"); }
    function workerId() { return owner() ? "owner" : access().workerId; }
    function allowedStore(id) {
      return admin() || (activeStaff() && id is string && id in access().stores);
    }
    function canReadStoreDoc() { return activeStaff() && allowedStore(resource.data.storeId); }
    function canCreateStoreDoc() { return activeStaff() && allowedStore(request.resource.data.storeId); }
    function canUpdateStoreDoc() {
      return activeStaff() && allowedStore(resource.data.storeId) &&
        request.resource.data.storeId == resource.data.storeId;
    }
    function processingOrderFields() {
      return request.resource.data.no == resource.data.no
        && request.resource.data.pieces == resource.data.pieces
        && request.resource.data.total == resource.data.total
        && request.resource.data.priceList == resource.data.priceList;
    }
    function riderOrderFields() {
      return request.resource.data.no == resource.data.no
        && request.resource.data.pieces == resource.data.pieces
        && request.resource.data.total == resource.data.total
        && request.resource.data.priceList == resource.data.priceList;
    }

    match /staffAccess/{staffEmail} {
      allow read: if admin() || (signedIn() && staffEmail == email());
      allow create, update, delete: if admin();
    }

    match /config/{document} {
      allow read: if activeStaff();
      allow write: if admin();
    }

    match /pub/{document} {
      allow get: if true;
      allow list: if false;
      allow write: if manager();
    }

    match /track/{document} {
      allow get: if true;
      allow list: if false;
      allow write: if activeStaff();
    }
    match /trackm/{document} {
      allow read, write: if false;
    }

    match /webreq/{document} {
      allow create: if !signedIn()
        && request.resource.data.keys().hasOnly(['storeId','name','mobile','flat','apartment','area','date','slot','svcs','instr','at','status'])
        && request.resource.data.status == 'New'
        && request.resource.data.storeId is string && request.resource.data.storeId.size() >= 1 && request.resource.data.storeId.size() <= 100
        && request.resource.data.mobile is string && request.resource.data.mobile.matches('^[0-9]{10}$')
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.slot is string && request.resource.data.slot.matches('^[0-9]{2}:[0-9]{2}-[0-9]{2}:[0-9]{2}$')
        && request.resource.data.at is string && request.resource.data.at.size() >= 20 && request.resource.data.at.size() <= 40
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 60
        && request.resource.data.flat is string && request.resource.data.flat.size() <= 60
        && request.resource.data.apartment is string && request.resource.data.apartment.size() <= 80
        && request.resource.data.area is string && request.resource.data.area.size() <= 80
        && request.resource.data.svcs is string && request.resource.data.svcs.size() <= 200
        && request.resource.data.instr is string && request.resource.data.instr.size() <= 300;
      allow read, update: if manager() && allowedStore(resource.data.storeId);
      allow delete: if admin() && allowedStore(resource.data.storeId);
    }

    match /workers/{id} {
      allow read: if admin() || (role("Store manager") && resource.data.stores.hasAny(access().stores)) ||
        (activeStaff() && id == workerId());
      allow write: if admin();
    }
    match /employees/{id} { allow read, write: if admin(); }

    match /attendance/{id} {
      allow read: if (manager() && allowedStore(resource.data.storeId)) || (activeStaff() && resource.data.w == workerId());
      allow create: if (manager() && allowedStore(request.resource.data.storeId)) || (activeStaff() && request.resource.data.w == workerId() && allowedStore(request.resource.data.storeId));
      allow update: if (manager() && allowedStore(resource.data.storeId) && request.resource.data.storeId == resource.data.storeId) || (activeStaff() && resource.data.w == workerId() && request.resource.data.w == resource.data.w && request.resource.data.storeId == resource.data.storeId);
      allow delete: if admin() && allowedStore(resource.data.storeId);
    }
    match /wpays/{id} {
      allow read: if (manager() && allowedStore(resource.data.storeId)) || (activeStaff() && resource.data.w == workerId());
      allow create: if manager() && allowedStore(request.resource.data.storeId);
      allow update: if manager() && allowedStore(resource.data.storeId) && request.resource.data.storeId == resource.data.storeId;
      allow delete: if admin() && allowedStore(resource.data.storeId);
    }
    match /advances/{id} {
      allow read: if (manager() && allowedStore(resource.data.storeId)) || (activeStaff() && resource.data.w == workerId());
      allow create: if manager() && allowedStore(request.resource.data.storeId);
      allow update: if manager() && allowedStore(resource.data.storeId) && request.resource.data.storeId == resource.data.storeId;
      allow delete: if admin() && allowedStore(resource.data.storeId);
    }

    match /customers/{id} {
      allow read: if activeStaff() && allowedStore(resource.data.homeStore);
      allow create: if (manager() || counter() || rider()) && allowedStore(request.resource.data.homeStore);
      allow update: if (manager() || counter() || rider()) && allowedStore(resource.data.homeStore) && request.resource.data.homeStore == resource.data.homeStore;
      allow delete: if admin() && allowedStore(resource.data.homeStore);
    }

    match /{collection}/{id} {
      allow read: if collection in ['stores','services','groups','products','routes','pricelists','colors','workTypes','pieceRates'] && activeStaff();
      allow create, update: if collection in ['stores','services','groups','products','routes','pricelists','colors','workTypes','pieceRates'] && manager();
      allow delete: if collection in ['stores','services','groups','products','routes','pricelists','colors','workTypes','pieceRates'] && admin();
    }

    match /vendors/{id} {
      allow read, create, update: if manager();
      allow delete: if admin();
    }

    match /orders/{id} {
      allow read: if canReadStoreDoc();
      allow create: if canCreateStoreDoc() && (manager() || counter() || processor() || rider());
      allow update: if canUpdateStoreDoc() &&
        ((processor() && processingOrderFields()) || (rider() && riderOrderFields()) || manager() || counter());
      allow delete: if admin() && canReadStoreDoc();
    }

    match /{collection}/{id} {
      allow read: if collection in ['pickups','complaints','trips','closings','rcash'] && canReadStoreDoc();
      allow create: if collection in ['pickups','complaints','trips','closings','rcash'] && canCreateStoreDoc() &&
        (manager() || counter() || (rider() && collection in ['pickups','complaints','trips','rcash']));
      allow update: if collection in ['pickups','complaints','trips','closings','rcash'] && canUpdateStoreDoc() &&
        (manager() || counter() || (rider() && collection in ['pickups','complaints','trips','rcash']));
      allow delete: if collection in ['pickups','complaints','trips','closings','rcash'] && admin() && canReadStoreDoc();
    }

    match /counters/{id} {
      allow read: if activeStaff();
      allow create: if activeStaff() && allowedStore(request.resource.data.storeId)
        && request.resource.data.keys().hasOnly(['last','start','storeId','kind'])
        && request.resource.data.storeId is string && request.resource.data.kind is string
        && id == request.resource.data.storeId + '_' + request.resource.data.kind
        && request.resource.data.last is int && request.resource.data.start is int
        && request.resource.data.last == request.resource.data.start;
      allow update: if activeStaff() && allowedStore(resource.data.storeId)
        && request.resource.data.keys().hasOnly(['last','start','storeId','kind'])
        && request.resource.data.storeId == resource.data.storeId && request.resource.data.kind == resource.data.kind
        && id == request.resource.data.storeId + '_' + request.resource.data.kind
        && request.resource.data.last is int && request.resource.data.start is int
        && request.resource.data.last >= request.resource.data.start
        && (request.resource.data.last == resource.data.last + 1 || request.resource.data.last == request.resource.data.start);
      allow delete: if admin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
